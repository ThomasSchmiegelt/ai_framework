# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtuelle Umgebung
venv/
.venv/

# Laufzeitdaten (lokal, nicht versionieren) – Wildcards, damit auch
# umbenannte/alte Datenbanken & Logs niemals versehentlich committet werden.
data/*.db
data/*.db-wal
data/*.db-shm
data/*.log
data/uploads/*
data/reports/*
data/conversations/*
data/code/*
data/plans/*
data/dossiers/*
data/compare/*
data/user_profile.json
data/projects.json
data/profile_assets/*
data/mail.json
data/mail_rules.json
data/api_providers.json
data/epo_ops.json
data/juries/*
data/jury_docs/*
data/morph_training/*
data/rfq/*
data/capacity.json
data/capacity_lists.json
data/feedback.md
# Postfach-Import (eingelesene PST/Mails + Anhänge = PRIVATE Daten, niemals versionieren)
data/pst/
# Angebote/Rechnungen/Patente (echte Kunden-/Finanz-/Recherchedaten = PRIVAT, niemals versionieren)
data/angebote/
data/rechnungen/
data/patente/
data/todo/
data/todo_att/
data/varianten/
data/transcripts/
data/orchestrator/

# Lokale Spracherkennungs-Modelle (faster-whisper, von HuggingFace geladen — groß, nicht ins Repo)
models/

# Selbstsignierte TLS-Zertifikate (privater Schlüssel!) — siehe scripts/gen_cert.*
certs/

# Verzeichnisstruktur erhalten (Inhalt ignoriert)
!data/uploads/.gitkeep
!data/reports/.gitkeep
!data/code/.gitkeep
!data/plans/.gitkeep
!data/dossiers/.gitkeep
!data/profile_assets/.gitkeep
!data/jury_docs/.gitkeep
!data/rfq/.gitkeep

# Agenten (Standard-Vorlagen) werden versioniert -> NICHT ignorieren
# data/agents/  bleibt eingecheckt; nur der Seeding-Marker ist Laufzeit-State:
data/agents/.seeded

# Persoenlicher Starter (nur lokal, enthaelt eine Sitzungs-ID)
restart.sh

# Laufzeit-Logs beliebiger Instanzen
*.log

# Laufzeit-/Dev-Artefakte
/server.log
/_test_*.py
/_smoke_*.py
/_smoke_*.log
.claude/

# Lokale Projekt-Snapshots/Backups (manuell erstellte ZIPs, nicht versionieren)
consoc*.zip

# Build-Ausgaben der Paketierung (ACMP-Updatepaket, MSI)
/_acmp/
/_update.log
packaging/wix/out/
packaging/wix/payload/
packaging/wix/AppFiles.wxs

# Z-Image-Turbo (lokales Bildmodell): venv/Ausgaben nicht versionieren.
# (venv/ und *.log sind bereits oben global ignoriert; hier nur die Bilder.)
z-image/outputs/
z-image/venv/
# Hugging-Face-Token (GEHEIM!) — niemals versionieren
z-image/hf_token.txt

# Musik-Generator: erzeugte Audiodateien nicht versionieren
z-music/outputs/

# Betriebssystem / Editor
Thumbs.db
.DS_Store
*.tmp
*~
*.bak

# Windows-Verknuepfungen (plattformspezifisch, gehoeren nicht ins Repo)
*.lnk

# Persoenliche Notizen / versehentliche Paketierungs-Artefakte (nur lokal)
to_do_Liste.txt
make_portable_nomodels.zip

# Firmeneigene Branding-Vorlagen ("Modern Blau") = PRIVAT, niemals versionieren.
# Nur README.md und .gitkeep bleiben eingecheckt (Struktur), die Bilddateien nicht.
weitere Vorlagen/**/*.png
weitere Vorlagen/**/*.jpg
weitere Vorlagen/**/*.jpeg
weitere Vorlagen/**/*.webp
!weitere Vorlagen/**/README.md
!weitere Vorlagen/**/.gitkeep
